{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "apps/dashboard/dist",
    "docs/.vitepress/dist",
    "docs/.vitepress/cache",
    "coverage",
    "**/*.tsbuildinfo"
  ],
  "env": {
    "builtin": true
  }
}
