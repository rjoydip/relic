{
  "name": "relic",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --build --force && tsc -p apps/dashboard && tsc -p tests",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:security": "bun test tests/security",
    "test:e2e": "playwright test",
    "build": "tsc --build --force && tsc -p apps/dashboard && tsc -p tests && vite build apps/dashboard && bun run docs:build && cd apps/api && bun run build",
    "dev:api": "bun run apps/api/src/index.ts",
    "dev:dashboard": "bun scripts/dev.mjs",
    "dev:mcp": "bun run apps/mcp-server/src/index.ts",
    "docs:dev": "bun run --filter @relic/docs dev",
    "docs:build": "bun run --filter @relic/docs build",
    "docs:preview": "bun run --filter @relic/docs preview",
    "site:build": "bun run build",
    "deploy": "alchemy deploy",
    "ci": "bun run format:check && bun run lint && bun run test:coverage && bun run test:security && bun run build",
    "dev": "bun scripts/dev.mjs",
    "dev:web": "vite apps/dashboard --open --strictPort"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "^2.0.0-beta.85",
    "@effect/platform-bun": "^4.1.2",
    "@effect/platform-node": "^4.1.2",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@playwright/test": "^1.64.1",
    "@relic/analyzer-typescript": "workspace:*",
    "@relic/database": "workspace:*",
    "@relic/graph-core": "workspace:*",
    "@relic/indexer": "workspace:*",
    "@types/bun": "^1.3.0",
    "alchemy": "^2.0.0-beta.85",
    "effect": "^4.1.2",
    "esbuild": "^0.28.2",
    "hono": "^4.9.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
