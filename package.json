{
  "name": "mcp-dependency-graph",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --build --force && tsc -p apps/dashboard && tsc -p tests",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "tsc --build --force && tsc -p apps/dashboard && tsc -p tests && vite build apps/dashboard",
    "dev:api": "bun run apps/api/src/index.ts",
    "dev:mcp": "bun run apps/mcp-server/src/index.ts",
    "ci": "bun run format:check && bun run lint && bun run test:coverage && bun run build"
  },
  "devDependencies": {
    "@mcpdg/analyzer-typescript": "workspace:*",
    "@mcpdg/database": "workspace:*",
    "@mcpdg/graph-core": "workspace:*",
    "@mcpdg/indexer": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@types/bun": "^1.3.0",
    "hono": "^4.9.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
