{
  "name": "relic-graph",
  "version": "0.1.0",
  "description": "Relic — codebase dependency graph: MCP server, incremental TypeScript indexer, and visual dashboard",
  "keywords": [
    "code-graph",
    "dependency-graph",
    "mcp",
    "static-analysis",
    "typescript"
  ],
  "bin": {
    "relic": "./dist/cli.js",
    "relic-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "hono": "^4.9.6",
    "typescript": "^5.9.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@relic/analyzer-typescript": "workspace:*",
    "@relic/graph-core": "workspace:*",
    "@relic/indexer": "workspace:*",
    "@relic/mcp-server": "workspace:*"
  },
  "engines": {
    "node": ">=23.4.0"
  }
}
